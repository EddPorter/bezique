{
  "name": "bezique",
  "private": true,
  "version": "0.0.1",
  "description": "A single-player Bezique card game for the browser, with computer opponents and an optional tutor that explains its moves.",
  "keywords": [
    "bezique",
    "rubicon-bezique",
    "card-game",
    "game",
    "tutor",
    "react",
    "typescript",
    "vite"
  ],
  "homepage": "https://eddporter.github.io/bezique/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/EddPorter/bezique.git"
  },
  "bugs": {
    "url": "https://github.com/EddPorter/bezique/issues"
  },
  "author": "Edd Porter",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "optimize:expert": "vitest run --config vitest.optimize.config.ts"
  },
  "dependencies": {
    "framer-motion": "^13.1.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0"
  },
  "devDependencies": {
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@vitejs/plugin-react": "^4.3.4",
    "typescript": "^5.7.0",
    "vite": "^6.0.0",
    "vitest": "^4.1.10"
  }
}
